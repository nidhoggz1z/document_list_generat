# Runtime configuration template (T27). No secrets in this file.
# Copy as model-api.env to the project root (source) or beside main.py (deployment).
# Replace six placeholders. Loaded at startup; process environment takes priority.
# Keep the file outside src.tar and mount it read-only in Docker. Restart to apply.
EXTRACT_MODEL_API_URL=https://model-api.example.com/v1/chat/completions
EXTRACT_MODEL_API_KEY=replace-with-extract-api-key
EXTRACT_MODEL_NAME=replace-with-extract-model-name
GENERATE_MODEL_API_URL=https://model-api.example.com/v1/chat/completions
GENERATE_MODEL_API_KEY=replace-with-generate-api-key
GENERATE_MODEL_NAME=replace-with-generate-model-name

# URLs are complete Chat Completions endpoints, used verbatim.
# Extract model must support image_url PNG data URIs for every PDF page.
# Invalid/missing model settings: create returns 503; retrieval/history still work.
# Optional: read-only rules. Source default: project list; archive default: sibling list.
# DOCUMENT_DIR=/home/app/list
# Optional: persistent writable storage, one process/worker only; never package it.
# Default: task_storage beside task_settings.py. Linux container example:
# TASK_STORAGE_ROOT=/home/app/task_storage
# Windows example: D:/10月重点项目/文件检索/task_storage

# EACH network request timeout, not a task SLA.
MODEL_REQUEST_TIMEOUT_SECONDS=180
# Additional network attempts and structural repair budget; 0 disables retries.
MODEL_MAX_RETRIES=2
# No configured context/output token limits; truncated/partial output fails.
# Never print API keys or put them in businessData, source, prompts or reports.
