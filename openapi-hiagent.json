{
  "openapi": "3.0.3",
  "info": {
    "title": "放款材料文件检索服务",
    "description": "输入完整项目名称，严格匹配材料清单并返回完整正文纯文本；list 更新后下次查询自动生效。",
    "version": "2.2.0"
  },
  "paths": {
    "/retrieve": {
      "post": {
        "summary": "按项目名称严格获取材料清单正文",
        "operationId": "retrieveDocuments",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrievalInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "项目对应的材料清单不存在"
          },
          "409": {
            "description": "存在重复项目名称"
          },
          "503": {
            "description": "清单损坏、正在更新或目录不可用，请修复后重试"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
